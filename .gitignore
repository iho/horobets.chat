# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# rustc will dump stack traces when hitting an internal compiler error to PWD
rustc-ice-*.txt

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/
prompt.md
graft

# Runtime workspace databases and blobs
/data/
.ignore
# Skip, Xcode, Gradle and generated Rust mobile bindings
mobile/.build/
mobile/.swiftpm/
mobile/Android/.gradle/
mobile/Android/.kotlin/
mobile/Android/app/build/
mobile/Android/local.properties
mobile/Android/keystore.properties
mobile/Android/app/src/main/jniLibs/
mobile/Bridge/MessengerCoreFFI.xcframework/
mobile/Bridge/Headers/
mobile/Bridge/Sources/MessengerCore/Generated.swift
mobile/Sources/MessengerApp/Skip/messenger_mobile.kt
**/xcuserdata/
*.xcuserstate

# Push provider credentials and per-deployment Firebase configuration
*.p8
/secrets/
**/google-services.json
mobile/Android/app/src/main/res/values/firebase.xml
